{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "target": "esnext",
    "verbatimModuleSyntax": true,

    // jsx
    "jsx": "preserve",
    "jsxImportSource": "vue-jsx"
  },
  "exclude": ["**/*.config.js", "./dist/**/*"],
  "include": ["**/*.js", "**/*.ts", "**/*.jsx", "**/*.tsx"]
}
